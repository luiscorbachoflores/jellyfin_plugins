<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jellyfin.Plugin.Watchlist</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Watchlist</RootNamespace>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    TODO: confirmar targetAbi contra producción (Watchlist, spec 0004).
    Jellyfin.Controller/Jellyfin.Model se fijan aquí a 12.2.0 porque es el ABI que
    manifest.json ya da por promovido a producción para Reviews 1.5.1.0 / JellyAsk 1.3.0.0
    (y el que usa WeeklyPick en su .csproj actual), pero nadie lo ha confirmado en vivo
    contra la Pi durante esta sesión (sin acceso a esa red desde aquí). Revisar
    config/plugins en el servidor real antes de cualquier release.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="12.2.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.2.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\watchlist.js" />
  </ItemGroup>

</Project>
