<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jellyfin.Plugin.Watchlist</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Watchlist</RootNamespace>
    <Version>1.1.0.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Para probar contra otra version de Jellyfin: dotnet build -p:JellyfinVersion=12.4.0 -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.2.0</JellyfinVersion>
  </PropertyGroup>

  <!-- targetAbi 12.2.0 confirmado contra un Jellyfin 12.2 real (jellyfin/jellyfin:12.2 en produccion):
       carga limpio, sin "not supported". -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <!-- Version explicita: la 2.1.10 que arrastra Microsoft.Data.Sqlite 9.0.0 tiene una vulnerabilidad conocida (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\watchlist.js" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
